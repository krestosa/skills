{
  "schemaVersion": 8,
  "orchestrator": "orchestrator/SKILL.md",
  "shared": {
    "root": "shared",
    "routesManifest": "shared/manifests/routes.json",
    "modelPolicy": "shared/policies/gpt-5.6-sol.md",
    "readCatalog": "shared/catalogs/github-read-verbatim.md",
    "writeCatalog": "shared/catalogs/github-write-verbatim.md"
  },
  "practicalReasoningContract": {
    "appliesToAllSkills": true,
    "purpose": "preserve strong Ergon and Arete while adding Eudaimonia, Telos, and Phronesis as governing layers",
    "operationalOrder": [
      "eudaimonia",
      "telos",
      "ergon",
      "phronesis",
      "arete"
    ],
    "phronesisIsContinuousFeedback": true,
    "deriveWithoutDuplicatingSkillText": {
      "eudaimonia": [
        "explicit user values",
        "protected interests from main"
      ],
      "telos": [
        "current request outcome",
        "primary skill Goal"
      ],
      "ergon": [
        "skill Role",
        "requested deliverable",
        "required routes"
      ],
      "phronesis": [
        "Select when",
        "Exclude when",
        "current evidence",
        "constraints",
        "stop rules"
      ],
      "arete": [
        "Success criteria",
        "validation requirements"
      ]
    },
    "protectedHumanInterestsWhenMaterial": [
      "autonomy",
      "time",
      "work",
      "privacy",
      "safety",
      "resources",
      "accessibility",
      "maintainability",
      "future agency"
    ],
    "noPaternalisticGoalSubstitution": true,
    "doesNotAuthorizeSideEffects": true,
    "doesNotWeakenInvariants": true,
    "doesNotRequireChainOfThoughtDisclosure": true
  },
  "selectionPolicy": {
    "primarySkillRequired": true,
    "ordinaryActiveSkillTarget": {
      "min": 1,
      "max": 3,
      "hardLimit": false,
      "excludesCrossCutting": true
    },
    "loadDependenciesOnly": true,
    "readOnlyRoutesExcludeWriteSkills": true,
    "remoteWritesRequireMatchingAuthorization": true,
    "separateChatDelegationIsPromptOnlyUnlessToolExists": true,
    "crossCuttingSkillIds": [
      "parallel-execution",
      "local-git-workspace",
      "chat-recovery",
      "practical-reasoning"
    ],
    "autoAttach": {
      "practical-reasoning": {
        "default": "attach-unless-trivial",
        "attachWhenAny": [
          "the task requires planning, implementation, diagnosis, review, delegation, recovery, tradeoffs, adaptation, validation, or external effects",
          "multiple technically valid approaches differ in user benefit, risk, cost, reversibility, or time",
          "new evidence may require changing tactics",
          "a delegated prompt must communicate purpose, adaptation rules, and quality"
        ],
        "skipWhenAll": [
          "the operation is exact, trivial, reversible, and mechanically specified",
          "there is no meaningful ambiguity, tradeoff, adaptation, risk, or quality decision"
        ],
        "lightweightGlobalFrameAlwaysActive": true,
        "preservesErgonAndArete": true,
        "addsEudaimoniaTelosAndPhronesis": true,
        "doesNotAuthorizeSideEffects": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      },
      "parallel-execution": {
        "default": "attach-when-applicable",
        "attachWhenAny": [
          "two or more independent tasks, tool calls, skills, modules, files, resources, errors, validations, or workstreams exist",
          "a multi-file or multi-module task contains independent work",
          "independent reads or checks can run concurrently",
          "chat recovery contains independent mount, filesystem, process, artifact, repository, or remote inspections"
        ],
        "skipWhenAny": [
          "single indivisible operation",
          "strict dependency chain",
          "single-resource mutation with no concurrent reads or checks",
          "infrastructure cannot execute useful work concurrently"
        ],
        "doesNotAuthorizeSideEffects": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      },
      "local-git-workspace": {
        "default": "attach-before-local-git",
        "attachWhenAny": [
          "the selected work will execute any local git command",
          "the task inspects or changes a local Git repository",
          "Git reports detected dubious ownership for an active repository",
          "chat recovery needs local Git evidence from any discovered repository"
        ],
        "skipWhenAny": [
          "the task is remote-only and uses no local Git repository",
          "no local filesystem environment exists",
          "no discovered filesystem contains a .git file or directory and no local Git command will run"
        ],
        "requiresRootRuntime": true,
        "runBeforeFirstLocalGitCommand": true,
        "onePreflightPerWorkspace": true,
        "ownershipCommand": "sudo -n chown -R \"$(id -u):$(id -g)\" -- \"$repo_root\"",
        "rootFallbackWhenSudoUnavailable": "chown -R \"$(id -u):$(id -g)\" -- \"$repo_root\"",
        "prohibitsSafeDirectoryFallback": true,
        "authorizedLocalMetadataRepairOnly": true,
        "doesNotAuthorizeRemoteWrites": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      },
      "chat-recovery": {
        "default": "attach-on-interrupted-delegated-chat",
        "attachWhenAny": [
          "a chat previously directed by the orchestrator is stalled or frozen",
          "the user manually stopped or cancelled a delegated chat",
          "a delegated chat disconnected, timed out, or returned a truncated response",
          "the delegated chat produced no trustworthy terminal report",
          "it is unknown which local or remote actions completed"
        ],
        "skipWhenAny": [
          "the delegated chat returned a complete and trustworthy terminal result",
          "no prior delegated work exists",
          "the request concerns repository recovery unrelated to an interrupted chat"
        ],
        "requiresFullEnvironmentInventoryBeforeMutation": true,
        "inventoryBoundary": "accessible-runtime-filesystem",
        "inventoryStartsAt": "/",
        "discoversAllMountedFilesystems": true,
        "noDateFilter": true,
        "noGitRepositoryOrWorkspaceFilter": true,
        "inventoryIncludesAllAccessibleFilesystemEntries": true,
        "inventoryIncludesSystemUserWorkspaceTemporaryCacheGeneratedHiddenBinarySymlinkAndOutsideRepositoryFiles": true,
        "recordsExcludedVirtualFilesystems": true,
        "recordsInaccessiblePaths": true,
        "doesNotFollowSymlinksRecursively": true,
        "reuseExistingValidFiles": true,
        "prohibitsUnnecessaryGenerationAndRegeneration": true,
        "unknownStateIsNotNotStarted": true,
        "requiresIdempotentContinuationPrompt": true,
        "promptOnlyResponse": true,
        "doesNotAuthorizeSideEffects": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      }
    }
  },
