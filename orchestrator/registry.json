{
  "schemaVersion": 6,
  "orchestrator": "orchestrator/SKILL.md",
  "shared": {
    "root": "shared",
    "routesManifest": "shared/manifests/routes.json",
    "modelPolicy": "shared/policies/gpt-5.6-sol.md",
    "readCatalog": "shared/catalogs/github-read-verbatim.md",
    "writeCatalog": "shared/catalogs/github-write-verbatim.md"
  },
  "selectionPolicy": {
    "primarySkillRequired": true,
    "ordinaryActiveSkillTarget": {
      "min": 1,
      "max": 3,
      "hardLimit": false,
      "excludesCrossCutting": true
    },
    "loadDependenciesOnly": true,
    "readOnlyRoutesExcludeWriteSkills": true,
    "remoteWritesRequireMatchingAuthorization": true,
    "separateChatDelegationIsPromptOnlyUnlessToolExists": true,
    "crossCuttingSkillIds": [
      "parallel-execution",
      "local-git-workspace",
      "chat-recovery"
    ],
    "autoAttach": {
      "parallel-execution": {
        "default": "attach-when-applicable",
        "attachWhenAny": [
          "two or more independent tasks, tool calls, skills, modules, files, resources, errors, validations, or workstreams exist",
          "a multi-file or multi-module task contains independent work",
          "independent reads or checks can run concurrently",
          "chat recovery contains independent workspace, process, artifact, repository, or remote inspections"
        ],
        "skipWhenAny": [
          "single indivisible operation",
          "strict dependency chain",
          "single-resource mutation with no concurrent reads or checks",
          "infrastructure cannot execute useful work concurrently"
        ],
        "doesNotAuthorizeSideEffects": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      },
      "local-git-workspace": {
        "default": "attach-before-local-git",
        "attachWhenAny": [
          "the selected work will execute any local git command",
          "the task inspects or changes a local Git repository",
          "Git reports detected dubious ownership for the active workspace",
          "chat recovery needs local Git evidence"
        ],
        "skipWhenAny": [
          "the task is remote-only and uses no local Git repository",
          "no local workspace exists",
          "the active workspace does not contain a .git file or directory and no local Git command will run"
        ],
        "requiresRootRuntime": true,
        "runBeforeFirstLocalGitCommand": true,
        "onePreflightPerWorkspace": true,
        "ownershipCommand": "sudo -n chown -R \"$(id -u):$(id -g)\" -- \"$repo_root\"",
        "rootFallbackWhenSudoUnavailable": "chown -R \"$(id -u):$(id -g)\" -- \"$repo_root\"",
        "prohibitsSafeDirectoryFallback": true,
        "authorizedLocalMetadataRepairOnly": true,
        "doesNotAuthorizeRemoteWrites": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      },
      "chat-recovery": {
        "default": "attach-on-interrupted-delegated-chat",
        "attachWhenAny": [
          "a chat previously directed by the orchestrator is stalled or frozen",
          "the user manually stopped or cancelled a delegated chat",
          "a delegated chat disconnected, timed out, or returned a truncated response",
          "the delegated chat produced no trustworthy terminal report",
          "it is unknown which local or remote actions completed"
        ],
        "skipWhenAny": [
          "the delegated chat returned a complete and trustworthy terminal result",
          "no prior delegated work exists",
          "the request concerns repository recovery unrelated to an interrupted chat"
        ],
        "requiresFullWorkspaceInventoryBeforeMutation": true,
        "inventoryBoundary": "active-workspace-only",
        "inventoryIncludesIgnoredGeneratedHiddenTemporaryAndBinary": true,
        "reuseExistingValidFiles": true,
        "prohibitsUnnecessaryRegeneration": true,
        "unknownStateIsNotNotStarted": true,
        "requiresIdempotentContinuationPrompt": true,
        "promptOnlyResponse": true,
        "doesNotAuthorizeSideEffects": true,
        "doesNotCountTowardOrdinaryActiveSkillTarget": true
      }
    }
  },
