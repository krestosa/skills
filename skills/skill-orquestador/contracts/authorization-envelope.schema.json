{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-orquestador/authorization-envelope.schema.json",
  "title": "Skill Orquestador Authorization Envelope",
  "type": "object",
  "required": [
    "authorization"
  ],
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "repository",
        "stage",
        "plan_revision",
        "base_sha",
        "branch",
        "objective",
        "allowed_paths",
        "prohibited_paths",
        "dependencies",
        "commits",
        "remote_writes",
        "validation"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "stage": {
          "enum": [
            "analysis",
            "implementation",
            "publication",
            "review-follow-up",
            "ci-rerun",
            "merge",
            "recovery"
          ]
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_new",
            "lockfile_change"
          ],
          "properties": {
            "allow_new": {
              "type": "boolean"
            },
            "lockfile_change": {
              "type": "boolean"
            }
          }
        },
        "commits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "message"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "message": {
              "type": "string"
            }
          }
        },
        "remote_writes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create_branch",
            "publish_commit",
            "create_pr",
            "update_pr",
            "issue_actions",
            "review_actions",
            "rerun_ci",
            "auto_merge",
            "merge",
            "contents_api",
            "git_data_api",
            "move_ref",
            "force_ref"
          ],
          "properties": {
            "create_branch": {
              "type": "boolean"
            },
            "publish_commit": {
              "type": "boolean"
            },
            "create_pr": {
              "type": "boolean"
            },
            "update_pr": {
              "type": "boolean"
            },
            "issue_actions": {
              "type": "boolean"
            },
            "review_actions": {
              "type": "boolean"
            },
            "rerun_ci": {
              "type": "boolean"
            },
            "auto_merge": {
              "type": "boolean"
            },
            "merge": {
              "type": "boolean"
            },
            "contents_api": {
              "type": "boolean"
            },
            "git_data_api": {
              "type": "boolean"
            },
            "move_ref": {
              "type": "boolean"
            },
            "force_ref": {
              "type": "boolean"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
