{
  "schemaVersion": 1,
  "id": "gpt-5.6-sol",
  "family": "gpt-5.6",
  "policyFile": "policies/gpt-5.6-sol.md",
  "referenceFile": "references/gpt-5.6-sol-prompting-guidance.md",
  "promptTemplateFile": "templates/gpt-5.6-prompt-contract.md",
  "evalFile": "evals/gpt-5.6-sol.json",
  "prompt": {
    "structure": [
      "role",
      "personality",
      "goal",
      "deliberativeSynthesis",
      "successCriteria",
      "constraints",
      "tools",
      "output",
      "stopRules"
    ],
    "outcomeFirst": true,
    "stableReusablePrefix": true,
    "absoluteLanguageReservedForInvariants": true,
    "preserveExplicitUserValues": true,
    "deliberativeSynthesis": {
      "sectionName": "Síntesis deliberativa",
      "canonicalContract": "orchestrator/registry.json#practicalReasoningContract.publicDeliberativeSynthesis",
      "insidePromptBlock": true,
      "taskSpecific": true,
      "contextOnly": true,
      "doesNotChangeReasoningRouting": true
    }
  },
  "text": {
    "verbosityDefault": "medium",
    "trimPriority": [
      "introductions",
      "repetition",
      "genericReassurance",
      "optionalExamples",
      "optionalBackground"
    ],
    "preservePriority": [
      "facts",
      "decisions",
      "caveats",
      "citations",
      "nextActions"
    ]
  },
  "reasoning": {
    "orchestratorRuntime": {
      "model": "latest-available",
      "effort": "high",
      "userConfigured": true
    },
    "delegatedPrompts": {
      "model": "latest-available",
      "allowedEfforts": [
        "instant",
        "medium",
        "high"
      ],
      "recomputePerPrompt": true,
      "recomputePerIteration": true,
      "directiveOutsidePrompt": true,
      "directivePosition": "after-prompt",
      "directiveFinalOutputElement": true,
      "directiveIncludesModel": false,
      "directiveFormat": "Razonamiento: <Instant|Medium|High>",
      "promptClosureDiscountMaxLevels": 1,
      "hardTriggersPreventDowngrade": true
    },
    "classifier": {
      "dimensions": {
        "telosClarity": [
          "closed",
          "partial",
          "open"
        ],
        "ergonComplexity": [
          "low",
          "moderate",
          "high"
        ],
        "phronesisAdaptation": [
          "low",
          "moderate",
          "high"
        ],
        "areteValidation": [
          "low",
          "moderate",
          "high"
        ],
        "riskAndReversibility": [
          "low",
          "moderate",
          "high"
        ],
        "stateUncertainty": [
          "known",
          "partial",
          "unknown"
        ],
        "promptClosure": [
          "fully-closed",
          "bounded",
          "open-ended"
        ]
      },
      "hardTriggers": [
        "architecture-or-systemic-redesign",
        "cross-subsystem-change",
        "complex-migration-or-compatibility",
        "unknown-or-interrupted-state",
        "contradictory-evidence",
        "multiple-repositories-or-services",
        "multi-cause-debugging",
        "security-secrets-identity-permissions-or-authentication",
        "destructive-or-difficult-to-reverse-action",
        "critical-release-or-production-change",
        "high-impact-legal-medical-or-financial-decision",
        "global-policy-or-orchestrator-modification",
        "classification-of-work-for-other-agents",
        "dynamic-replanning",
        "extensive-cross-validation",
        "high-risk-of-work-loss",
        "open-objective"
      ],
      "selection": {
        "instant": "all-material-dimensions-low-or-closed-and-no-strategic-choice",
        "medium": "bounded-non-trivial-professional-work-with-limited-local-decisions",
        "high": "hard-trigger-or-material-combination-of-complexity-and-uncertainty"
      },
      "promptClosureAdjustment": {
        "allowed": [
          "high-to-medium",
          "medium-to-instant"
        ],
        "prohibited": [
          "high-to-instant"
        ],
        "requiresRemovalOf": [
          "ambiguity",
          "open-strategy",
          "branching",
          "undefined-fallbacks",
          "implicit-success-criteria",
          "reinterpretation"
        ]
      },
      "costRule": "choose-the-lowest-equally-reliable-level-by-total-user-cost"
    },
    "migrationBaseline": "preserve-current-setting",
    "defaultWhenNoBaseline": "adaptive-per-prompt",
    "comparisonLevel": "one-level-lower-when-eligible",
    "highOrAboveRequiresEvalGain": false,
    "maxGlobalRecommendation": false
  },
  "retrieval": {
    "ordinaryInitialBroadCalls": 1,
    "meaningfulFallbacksMax": 2,
    "absenceIsNotNegativeFact": true,
    "repeatForPhrasingOnly": false
  },
  "tools": {
    "defaultRoute": "direct",
    "parallelizeIndependentReads": true,
    "sequenceDependentCalls": true,
    "programmaticCalling": {
      "allowedStage": "bounded-record-reduction",
      "readOnly": true,
      "transientRetriesMax": 2,
      "directHandoffRequired": true,
      "prohibitedFor": [
        "approval",
        "externalWrites",
        "semanticJudgment",
        "citations",
        "finalValidation"
      ]
    }
  },
  "updates": {
    "preambleForMultiStepTools": true,
    "preambleSentencesMax": 2,
    "majorPhaseUpdatesOnly": true,
    "routineCallNarration": false
  },
  "validation": {
    "minimumEvalCases": 42,
    "evalRequiredFields": [
      "id",
      "category",
      "request",
      "assertions"
    ],
    "evalNonEmptyArrayFields": [
      "assertions"
    ]
  },
  "referenceProvenance": "user-supplied-guidance",
  "integrity": {
    "referenceSha256": "cd838a4bd951509771738a3fe511c99cfccc229236ca45503c8181f6bb5ea9b9",
    "policySha256": "79499f5a8771de7782e4884b734bf9518070723c4aabb7798b7d365003ca19c0",
    "promptTemplateSha256": "d92f66e737e4dc66ffee4301456d69057366c6d0aa8d6d58d37b2f134a2e0e24",
    "evalSha256": "3c07fa2cd5b8acb266604c5bfb7227085e961111ec8791e28a0a7b80c577571c"
  }
}
